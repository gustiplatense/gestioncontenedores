# Login con Google (si queda vacío, la demo usa usuarios de prueba sin Google)
GOOGLE_CLIENT_ID=
# Primera cuenta de Google con rol administrador
ADMIN_EMAIL=
# Cuenta que envía los mails (ejemplo con Gmail y contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Dirección de la empresa que recibe los reclamos (valor inicial; se cambia en Ajustes)
EMPRESA_EMAIL=
# Asistente de IA (opcional; también se configura en Ajustes)
# LLM_PROVEEDOR: anthropic | openai | gemini | compatible
LLM_PROVEEDOR=
LLM_API_KEY=
LLM_MODELO=
# Solo para 'compatible' (o para usar otra URL): por ejemplo https://api.deepseek.com/v1
LLM_BASE_URL=
# Clave para las aplicaciones de terceros que reportan lecturas
API_KEY=demo-key
PORT=3000
